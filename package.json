{
  "name": "avyn-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "node scripts/build-preview.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:release": "node scripts/release-guard.mjs",
    "test:release-guard": "node --test scripts/release-guard.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:i18n:export": "node scripts/check-i18n.mjs --export"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
